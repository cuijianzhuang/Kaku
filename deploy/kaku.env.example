# 必填：主密钥，加密卡密、发货内容和支付密钥。用 `kaku keygen` 生成，务必备份——丢失后已存卡密无法解密。
KAKU_MASTER_KEY=

# 首次启动创建的管理员
ADMIN_USER=admin
ADMIN_PASSWORD=

# 后台路径，建议改成不易猜到的，例如 /manage-7f3k
ADMIN_PATH=/admin

# 数据库：默认 SQLite（/data/kaku.db）。使用 PostgreSQL 时：
# DB_DRIVER=postgres
# DB_DSN=postgres://kaku:password@postgres:5432/kaku?sslmode=disable
